generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String
  avatar    String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  scores   Score[]

  @@map("users")
}

// ─── Session ─────────────────────────────────────────────────────────────────

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ─── Game ────────────────────────────────────────────────────────────────────

model Game {
  id        String     @id @default(cuid())
  status    GameStatus @default(WAITING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  rounds Round[]
  scores Score[]

  @@map("games")
}

enum GameStatus {
  WAITING
  PLAYING
  ENDED
}

// ─── Round ───────────────────────────────────────────────────────────────────

model Round {
  id        String      @id @default(cuid())
  gameId    String
  number    Int
  status    RoundStatus @default(ACTIVE)
  timeLimit Int         @default(180)
  startedAt DateTime?
  endedAt   DateTime?

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@map("rounds")
}

enum RoundStatus {
  ACTIVE
  ENDED
}

// ─── Score ───────────────────────────────────────────────────────────────────

model Score {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  points    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@map("scores")
}
