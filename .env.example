# Root env is intentionally minimal.
# Runtime configuration lives next to each service:
#
# apps/api-gateway/.env
# apps/realtime-gateway/.env
# apps/auth-service/.env
# apps/user-service/.env
# apps/game-service/.env
# apps/matchmaking-service/.env
# apps/chat-service/.env
# apps/notification-service/.env
# infrastructure/postgres/.env
#
# Copy each .env.example to .env before running Docker Compose.
